# Set in your process environment or use: node --env-file=.env server.mjs
# Never commit a real .env file.
HOST=127.0.0.1
PORT=3000
BRAVE_SEARCH_API_KEY=
# Daily public job discovery (recommendations stay in app)
JOB_ROLE=数据分析
JOB_REGION=全部
JOB_CITY=
JOB_EMPLOYMENT=不限
JOB_EXPERIENCE=应届

# Optional limits. Raising the search budget can affect provider charges.
JOB_SEARCH_BUDGET=24
JOB_SEARCH_PAGES=2
JOB_DETAIL_LIMIT=36
# Optional local public-page browser rendering; install Playwright Chromium first.
JOB_BROWSER_RENDER=false
# Optional personal search backend (never put the API key in browser config).
APP_ORIGINS=https://winne-wang0505.github.io
PERSONAL_STATE_FILE=.runtime/personal.json
PERSONAL_DAILY_BUDGET=6
PERSONAL_USER_BUDGET=4
# Enable only behind a trusted reverse proxy, such as Render's managed edge.
TRUST_PROXY=false
